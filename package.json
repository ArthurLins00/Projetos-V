{
  "name": "projetos-v",
  "version": "1.0.0",
  "private": true,
  "description": "Fiscalize — orquestração da suíte de testes (backend + E2E)",
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "dev:local:api": "node scripts/dev-local.mjs --no-mobile",
    "setup:local": "node scripts/dev-local.mjs --setup-only",
    "dev:backend": "npm run dev --prefix backend",
    "dev:ai": "npm run dev:local --prefix ai-agent",
    "dev:mobile": "npm run dev:local --prefix mobile",
    "test": "npm run test:all",
    "test:unit": "npm run test:unit --prefix backend",
    "test:api": "npm run test:api --prefix backend",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "maestro test mobile/e2e",
    "test:e2e:report": "playwright show-report e2e-report",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
