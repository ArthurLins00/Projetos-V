{
  "expo": {
    "name": "Fiscalize",
    "slug": "mobile",
    "scheme": "projetosv",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.projetosv.fiscalize"
    },
    "android": {
      "package": "com.projetosv.fiscalize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "chamados"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Fiscalize usa a câmera para fotografar as ocorrências.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Fiscalize acessa suas fotos para você escolher uma foto de perfil.",
          "cameraPermission": "O Fiscalize usa a câmera para fotografar as ocorrências e a sua foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Fiscalize usa sua localização para registrar onde a ocorrência aconteceu."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8610ecb4-1b2f-495c-a3f3-3339b8c3d7b7"
      }
    },
    "owner": "victorsimasdev"
  }
}
