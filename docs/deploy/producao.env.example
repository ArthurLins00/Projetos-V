# Modelo do .env de PRODUÇÃO. No servidor, copie para .env na raiz do repositório e preencha.
# Guia: docs/deploy/README.md — nunca faça commit do .env preenchido.
#
# Para gerar valores aleatórios no servidor:  openssl rand -base64 48

# Domínio (registro A no DNS apontando para o IP do servidor)
DOMINIO=fiscalize.seudominio.com.br

# Banco — a senha só é lida na PRIMEIRA criação do volume; defina antes de subir pela primeira vez
POSTGRES_USER=fiscalize
POSTGRES_PASSWORD=
POSTGRES_DB=fiscalize

# Backend
NODE_ENV=production
JWT_SECRET=
# Origens de navegador aceitas pelo CORS (o app mobile não envia Origin e não depende disso)
ALLOWED_ORIGINS=https://fiscalize.seudominio.com.br
# O Caddy fica na frente da API: sem isto o rate limit veria todos os clientes com o IP dele
TRUST_PROXY=1
DEMO_MODE=false
# true na primeira subida (cria categorias, órgãos, regras e o admin); depois pode voltar para false
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@fiscalize.gov.br
SEED_ADMIN_PASSWORD=
CRON_METRICS_SCHEDULE=0 * * * *

# E-mail dos códigos de verificação e de recuperação de senha (Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fiscalize

# Agente de IA (sobe com --profile ai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=15
AI_AGENT_SECRET=
