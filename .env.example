# Variáveis do compose.yaml. Copie para .env (na raiz) e ajuste; tudo é opcional para rodar localmente.
# Guia: docs/COMO_RODAR_COM_DOCKER.md

# Banco
POSTGRES_USER=fiscalize
POSTGRES_PASSWORD=fiscalize
POSTGRES_DB=fiscalize

# Portas publicadas no seu computador (troque se já estiverem em uso)
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000

# Backend
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
NODE_ENV=development
DEMO_MODE=false
SEED_ON_START=true
SEED_ADMIN_PASSWORD=Admin@123456
# ALLOWED_ORIGINS=          obrigatória com NODE_ENV=production

# E-mail (sem SMTP_HOST, os códigos de 2FA e de recuperação aparecem no log do backend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Fiscalize

# Agente de IA (perfil "ai")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_RPM=15
# Segredo compartilhado entre o backend e o agente (recomendado)
AI_AGENT_SECRET=
