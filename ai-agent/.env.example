# Chave da API do Google Gemini (crie em https://aistudio.google.com/apikey)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo usado pelo agente (opcional)
GEMINI_MODEL=gemini-3.1-flash-lite

# Limite de requisições por minuto da sua chave (plano gratuito: 15).
# O agente espera automaticamente para não ultrapassar esse valor.
GEMINI_RPM=15

# ── Modo servidor (npm run serve) — usado pelo chat do app via backend ──
# URL do backend do Fiscalize consultada pela ferramenta consultar_status_chamados
FISCALIZE_API_URL=http://localhost:3000
# Porta/host do serviço do agente (o backend aponta para cá em AI_AGENT_URL)
AI_AGENT_PORT=3333
AI_AGENT_HOST=127.0.0.1
# Opcional: segredo compartilhado com o backend (mesmo valor de AI_AGENT_SECRET no backend/.env)
# AI_AGENT_SECRET=troque-por-um-segredo
